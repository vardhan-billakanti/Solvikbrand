# SolvikBrand - Environment Configuration Template
# Copy to .env for local development

# Database connection string (SQLite file storage)
DATABASE_URL="file:./dev.db"

# Secret key for JWT signing and verification (HS256)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Owner administrator credentials
OWNER_USERNAME="admin"
OWNER_PASSWORD="your-secure-admin-password-here"

# Public base URL of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
