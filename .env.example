# SQLite database path
DATABASE_URL="file:./dev.db"

# JWT secret key for owner sessions (min 32 chars)
JWT_SECRET="your-super-secret-jwt-key-minimum-32-chars-change-this"

# Default owner credentials
OWNER_USERNAME="admin"
OWNER_PASSWORD="change-this-strong-password"

# Optional public base URL for generated Dvideo links
# Leave blank to dynamically use the active request/browser domain or Vercel production URL.
# Or set explicitly for custom tunneling/domains (e.g. https://dvideo.your-domain.com):
NEXT_PUBLIC_APP_URL=
